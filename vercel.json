{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --workspace=maktab-panel",
  "outputDirectory": "apps/maktab-panel/dist",
  "installCommand": "npm install",
  "framework": null,

  "//": "SPA: mavjud bo'lmagan yo'l index.html ga yo'naltiriladi. Vercel avval haqiqiy faylni qidiradi, shuning uchun assetlar buzilmaydi.",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
