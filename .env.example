# =====================================================================
#  Maktab Moliya CRM — muhit o'zgaruvchilari SHABLONI
#
#  Bu faylni `.env.local` ga nusxalang va haqiqiy qiymatlarni qo'ying.
#  `.env.local` git'ga TUSHMAYDI (.gitignore).
#
#  ⚠️ QOIDA: service_role kaliti va Telegram bot tokeni bu yerga
#  YOZILMAYDI. Ular faqat Edge Function maxfiy kalitlari sifatida
#  saqlanadi:  npx supabase secrets set NOMI=qiymat
# =====================================================================

# --- Brauzerga chiqadigan kalitlar (bu normal — himoya RLS darajasida) ---
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Faqat CLI uchun (supabase link / db push / functions deploy) ---
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_REF=xxxxxxxxxxxx

# --- Baza paroli (faqat `supabase db push` uchun so'raladi) ---
SUPABASE_DB_PASSWORD=
